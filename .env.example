# Copia este archivo a .env y completa con tus valores reales.
# NUNCA subas el archivo .env a git (ya está en .gitignore).

# Una o varias API keys de Gemini separadas por coma. Si hay más de una,
# llm_analyzer.py rota automáticamente a la siguiente cuando la actual
# devuelve error 429 (cuota/rate-limit agotada).
GEMINI_API_KEYS=tu_api_key_1,tu_api_key_2,tu_api_key_3

# Alternativa: una sola key (equivalente a GEMINI_API_KEYS con un solo valor)
# GEMINI_API_KEY=tu_api_key_de_google_ai_studio_aqui
